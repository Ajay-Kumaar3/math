# Given data
A <- c(12, 15, 14, 16, 13, 15, 17, 14)
B <- c(10, 13, 12, 15, 11, 14, 13, 12)

alpha <- 0.05

# a) Hypotheses
# H0: var(A) = var(B)
# H1: var(A) != var(B)

# b) Calculate sample variances
var_A <- var(A)
var_B <- var(B)

cat("Variance of Machine A =", var_A, "\n")
cat("Variance of Machine B =", var_B, "\n")

# c) Perform two-tailed F-test
result <- var.test(A, B,
                   alternative = "two.sided",
                   conf.level = 0.95)

# d) F-test statistic and critical values
F_stat <- result$statistic
df1 <- result$parameter[1]
df2 <- result$parameter[2]

lower_critical <- qf(alpha / 2, df1, df2)
upper_critical <- qf(1 - alpha / 2, df1, df2)

cat("F test statistic =", F_stat, "\n")
cat("Lower critical value =", lower_critical, "\n")
cat("Upper critical value =", upper_critical, "\n")

# e) P-value
p_value <- result$p.value
cat("P-value =", p_value, "\n")

# f) Decision
if (p_value < alpha) {
  cat("Reject H0\n")
  cat("The variances differ significantly.\n")
} else {
  cat("Fail to reject H0\n")
  cat("Insufficient evidence that the variances differ significantly.\n")
}